---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TasteList from '../../components/TasteList.astro';
import SpotifyTopTracks from '../../components/SpotifyTopTracks.astro';
import LetterboxdReviews from '../../components/LetterboxdReviews.astro';
import { getSite } from '../../lib/site';
import { getTopTracks } from '../../lib/spotify';
import { getLetterboxd } from '../../lib/letterboxd';

const site = await getSite();
const [books, creators, spotify, letterboxd] = await Promise.all([
  getCollection('books'),
  getCollection('creators'),
  // Fetched once at build time and cached; the widgets reuse the same result.
  // Only needed here so the jump links match the sections that actually render.
  getTopTracks(),
  getLetterboxd(site.letterboxd.username),
]);

const sections = [
  { title: 'Books', items: books, file: 'content/taste/books.yaml' },
  { title: 'Creators', items: creators, file: 'content/taste/creators.yaml' },
];
---

<Base title="Taste" description="Music, films, books, and the creators I'd point you to.">
  <h1>Taste</h1>
  <p class="muted">What I've been listening to, watching and reading — and the people who make things I admire. Newest at the top.</p>
  <nav class="jump label" aria-label="Sections">
    {spotify && <a href="#on-repeat">Music</a>}
    {letterboxd && <a href="#last-watched">Films</a>}
    {sections.map((s) => <a href={`#${s.title.toLowerCase()}`}>{s.title}</a>)}
  </nav>

  <SpotifyTopTracks />
  <LetterboxdReviews username={site.letterboxd.username} topCount={site.letterboxd.top_count} />

  {sections.map((s) => <TasteList title={s.title} items={s.items} file={s.file} />)}
</Base>

<style>
  .jump {
    display: flex;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }
  .jump a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .jump a:hover {
    color: var(--accent);
  }
</style>
