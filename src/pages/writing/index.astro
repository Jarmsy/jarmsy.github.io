---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import FilterChips from '../../components/FilterChips.astro';
import WritingItem from '../../components/WritingItem.astro';
import { getSite } from '../../lib/site';
import { byDateDesc } from '../../lib/format';

const site = await getSite();
const posts = (await getCollection('writing', ({ data }) => data.status !== 'draft')).sort(byDateDesc);

const kinds = [...new Set(posts.map((p) => p.data.kind))].sort();
const topics = [...new Set(posts.flatMap((p) => p.data.topics))].sort();
---

<Base title="Writing" description="Essays and notes.">
  <h1>Writing</h1>
  <p class="muted">Essays, and the occasional shorter note.</p>

  {posts.length === 0 ? (
    <Empty what="writing" where="content/writing/" />
  ) : (
    <div data-filter-scope>
      <FilterChips
        groups={[
          { key: 'kind', label: 'Kind', values: kinds },
          { key: 'topic', label: 'Topic', values: topics },
        ]}
      />
      <div class="list">
        {posts.map((post) => (
          <div data-filter-item data-kind={post.data.kind} data-topic={post.data.topics.join(',')}>
            <WritingItem post={post} locale={site.dates.locale} />
          </div>
        ))}
      </div>
    </div>
  )}
</Base>

<style>
  .list {
    margin-top: var(--space-3);
  }
</style>
