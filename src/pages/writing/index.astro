---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Writing" description="Longer-form pieces.">
  <h1>Writing</h1>
  <p style="color: var(--text-muted);">
    Pieces too long to be a hot take.
  </p>

  {posts.map((post) => (
    <article class="post-item">
      <h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3>
      {post.data.description && <p style="margin: 0.2rem 0;">{post.data.description}</p>}
      <span class="post-date">
        {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
      </span>
    </article>
  ))}
</Base>
