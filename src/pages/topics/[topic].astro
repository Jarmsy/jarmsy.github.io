---
// One page per topic, gathering writing, takes, work and questions that share the tag.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TakeCard from '../../components/TakeCard.astro';
import WritingItem from '../../components/WritingItem.astro';
import WorkCard from '../../components/WorkCard.astro';
import QuestionItem from '../../components/QuestionItem.astro';
import { getSite } from '../../lib/site';
import { byDateDesc } from '../../lib/format';

export async function getStaticPaths() {
  const [writing, takes, work, questions] = await Promise.all([
    getCollection('writing', ({ data }) => data.status !== 'draft'),
    getCollection('takes'),
    getCollection('work'),
    getCollection('questions'),
  ]);
  const topics = new Set([...writing, ...takes, ...work, ...questions].flatMap((e) => e.data.topics));
  return [...topics].map((topic) => ({
    params: { topic },
    props: {
      writing: writing.filter((e) => e.data.topics.includes(topic)).sort(byDateDesc),
      takes: takes.filter((e) => e.data.topics.includes(topic) && !e.data.retired).sort(byDateDesc),
      work: work.filter((e) => e.data.topics.includes(topic)).sort(byDateDesc),
      questions: questions.filter((e) => e.data.topics.includes(topic)),
    },
  }));
}

const { topic } = Astro.params;
const { writing, takes, work, questions } = Astro.props;
const site = await getSite();
const locale = site.dates.locale;
---

<Base title={`Topic: ${topic}`} description={`Everything on this site tagged “${topic}”.`}>
  <p class="label">Topic</p>
  <h1>{topic}</h1>

  {writing.length > 0 && (
    <section>
      <h2>Writing</h2>
      {writing.map((post) => <WritingItem post={post} locale={locale} />)}
    </section>
  )}
  {takes.length > 0 && (
    <section>
      <h2>Takes</h2>
      {takes.map((take) => <TakeCard take={take} spiceLabels={site.takes.spice} locale={locale} />)}
    </section>
  )}
  {work.length > 0 && (
    <section>
      <h2>Work</h2>
      {work.map((item) => <WorkCard item={item} />)}
    </section>
  )}
  {questions.length > 0 && (
    <section>
      <h2>Questions</h2>
      <ol class="plain">{questions.map((item) => <QuestionItem item={item} locale={locale} />)}</ol>
    </section>
  )}
</Base>

<style>
  section {
    margin-top: var(--space-5);
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
