---
// The front door. Which sections appear, in what order, and how many items
// each shows is set in site.yaml under `home`.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NowStrip from '../components/NowStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import TakeCard from '../components/TakeCard.astro';
import WritingItem from '../components/WritingItem.astro';
import MadeCard from '../components/MadeCard.astro';
import QuestionItem from '../components/QuestionItem.astro';
import { Image } from 'astro:assets';
import { getSite } from '../lib/site';
import { byDateDesc } from '../lib/format';

const site = await getSite();
const locale = site.dates.locale;

// The portrait is any file in content/photos/, named in site.yaml → portrait.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../../content/photos/*.{jpg,jpeg,png,webp,avif}');
const portraitPath = site.portrait ? `../../content/photos/${site.portrait}` : '';
if (portraitPath && !photoFiles[portraitPath]) {
  throw new Error(
    `site.yaml → portrait: "${site.portrait}" isn't in content/photos/. ` +
      `Files there: ${Object.keys(photoFiles).map((f) => f.split('/').pop()).join(', ') || '(none)'}`,
  );
}
const portrait = portraitPath ? (await photoFiles[portraitPath]()).default : null;

const takes = (await getCollection('takes', ({ data }) => !data.retired)).sort(byDateDesc);
const writing = (await getCollection('writing', ({ data }) => data.status !== 'draft')).sort(byDateDesc);
const made = (await getCollection('made'))
  .sort(byDateDesc)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const questions = await getCollection('questions');
// Films and music are covered live by the Letterboxd and Spotify widgets on
// the Taste page — no manual list for those, so no home-page line for them either.
const currently = (
  await Promise.all([
    getCollection('books').then((b) => ['Reading', b[0]] as const),
    getCollection('creators').then((c) => ['Following', c[0]] as const),
  ])
).filter(([, item]) => item);
---

<Base description={site.one_liner || site.motto}>
  <section class="hero">
    <div class="intro">
      <h1 class="name">{site.name}</h1>
      {site.one_liner && <p class="one-liner">{site.one_liner}</p>}
      {site.intro && <p class="intro-text">{site.intro.trim()}</p>}
    </div>
    {portrait && <Image src={portrait} alt={`${site.name}`} width={520} densities={[1, 2]} class="portrait" loading="eager" />}
  </section>

  {site.home.map(({ section, count }) => {
    switch (section) {
      case 'now':
        return <NowStrip locale={locale} />;
      case 'takes':
        return takes.length > 0 && (
          <>
            <SectionHead title="Latest takes" href="/takes/" more="all takes" />
            {takes.slice(0, count).map((take) => (
              <TakeCard take={take} spiceLabels={site.takes.spice} locale={locale} />
            ))}
          </>
        );
      case 'writing':
        return writing.length > 0 && (
          <>
            <SectionHead title="Writing" href="/writing/" more="all writing" />
            {writing.slice(0, count).map((post) => <WritingItem post={post} locale={locale} />)}
          </>
        );
      case 'made':
        return made.length > 0 && (
          <>
            <SectionHead title="Made" href="/made/" more="everything I've made" />
            {made.slice(0, count).map((item) => <MadeCard item={item} />)}
          </>
        );
      case 'taste':
        return currently.length > 0 && (
          <>
            <SectionHead title="Currently" href="/taste/" more="all taste" />
            <dl class="currently">
              {currently.map(([label, item]) => (
                <div>
                  <dt class="label">{label}</dt>
                  <dd>
                    {item!.data.title}
                    {item!.data.by && <span class="muted"> — {item!.data.by}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          </>
        );
      case 'questions':
        return questions.length > 0 && (
          <>
            <SectionHead title="Open questions" href="/questions/" more="all questions" />
            <ol class="plain">
              {questions.slice(0, count).map((item) => <QuestionItem item={item} locale={locale} />)}
            </ol>
          </>
        );
    }
  })}
</Base>

<style>
  /* Name and one-liner lead, then a short paragraph in John's words; the
     portrait sits beside them (above them on narrow screens). */
  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) 0 var(--space-4);
  }
  .intro {
    flex: 1 1 18rem;
    min-width: 0;
  }
  .name {
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-2);
  }
  .one-liner {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: var(--measure);
    margin: 0 0 var(--space-3);
  }
  .intro-text {
    max-width: var(--measure);
    margin: 0;
    text-wrap: pretty;
  }
  .portrait {
    flex: 0 0 auto;
    width: clamp(9rem, 26vw, 14rem);
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    object-position: 50% 25%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  @media (max-width: 40rem) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .intro {
      flex: none;
    }
    .portrait {
      width: 9rem;
    }
  }
  .currently {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  .currently dt {
    margin-bottom: var(--space-1);
  }
  .currently dd {
    margin: 0;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
