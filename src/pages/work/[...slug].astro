---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Article from '../../layouts/Article.astro';
import { getSite } from '../../lib/site';

export async function getStaticPaths() {
  const items = await getCollection('work');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const site = await getSite();
const { Content } = await render(item);
const { data } = item;
const facts = [
  ['Where', data.org],
  ['Role', data.role],
  ['When', data.period],
  ['Tools', data.tools.length ? data.tools.join(', ') : undefined],
  ['Outcome', data.outcome],
].filter(([, value]) => value) as [string, string][];
---

<Article
  title={data.title}
  description={data.summary}
  eyebrow="case study"
  date={data.date}
  topics={data.topics}
  locale={site.dates.locale}
  backHref="/work/"
  backLabel="Work"
>
  {data.cover && <Image src={data.cover} alt="" width={1200} class="cover" />}
  {facts.length > 0 && (
    <dl class="facts">
      {facts.map(([label, value]) => (
        <div>
          <dt class="label">{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )}
  {data.links.length > 0 && (
    <p class="links">
      {data.links.map((link) => <a href={link.href}>{link.label} →</a>)}
    </p>
  )}
  <Content />
</Article>

<style>
  .cover {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    margin-bottom: var(--space-4);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .facts dt {
    margin-bottom: var(--space-1);
  }
  .facts dd {
    margin: 0;
  }
  .links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
</style>
