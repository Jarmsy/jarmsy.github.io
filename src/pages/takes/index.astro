---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Empty from '../../components/Empty.astro';
import FilterChips from '../../components/FilterChips.astro';
import TakeCard from '../../components/TakeCard.astro';
import { getSite } from '../../lib/site';
import { byDateDesc } from '../../lib/format';

const site = await getSite();
const all = (await getCollection('takes')).sort(byDateDesc);
const active = all.filter((t) => !t.data.retired);
const retired = all.filter((t) => t.data.retired);
const topics = [...new Set(active.flatMap((t) => t.data.topics))].sort();
const [mild, , hill] = site.takes.spice;
---

<Base title="Takes" description={site.takes.subtitle || 'Short opinions, rated by spice.'}>
  <h1>Takes</h1>
  {site.takes.subtitle && <p class="subtitle">{site.takes.subtitle}</p>}
  <p class="muted">
    Rated from 🌶️ ({mild}) to 🌶️🌶️🌶️ ({hill}). Each one is stamped with when I last stood behind it.
  </p>

  {active.length === 0 ? (
    <Empty what="takes" where="content/takes/" />
  ) : (
    <div data-filter-scope>
      <FilterChips groups={[{ key: 'topic', label: 'Topic', values: topics }]} />
      {active.map((take) => (
        <div data-filter-item data-topic={take.data.topics.join(',')}>
          <TakeCard take={take} spiceLabels={site.takes.spice} locale={site.dates.locale} />
        </div>
      ))}
    </div>
  )}

  {retired.length > 0 && (
    <section class="retired">
      <h2>Retired takes</h2>
      <p class="muted">Things I no longer believe.</p>
      {retired.map((take) => (
        <TakeCard take={take} spiceLabels={site.takes.spice} locale={site.dates.locale} />
      ))}
    </section>
  )}
</Base>

<style>
  .subtitle {
    font-size: var(--step-1);
    font-style: italic;
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }
  .retired {
    margin-top: var(--space-6);
  }
</style>
