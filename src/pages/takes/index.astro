---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TakeCard from '../../components/TakeCard.astro';

const all = (await getCollection('takes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const active = all.filter((t) => !t.data.retired);
const retired = all.filter((t) => t.data.retired);

// Every topic used by at least one take, for the filter chips
const topics = [...new Set(active.flatMap((t) => t.data.topics))].sort();
---

<Base
  title="Hot Takes"
  description="Beliefs, sorted by topic and rated by spice level."
>
  <h1>Hot Takes</h1>
  <p style="color: var(--text-muted);">
    Things I believe, rated from 🌶️ (mild) to 🌶️🌶️🌶️ (will die on this hill).
    Each one is stamped with when I last stood behind it.
  </p>

  <div class="chip-row" id="topic-filters">
    <button class="chip active" data-topic="all">All</button>
    {topics.map((topic) => (
      <button class="chip" data-topic={topic}>{topic}</button>
    ))}
  </div>

  <div id="takes-list">
    {active.map((take) => <TakeCard take={take} />)}
  </div>

  {retired.length > 0 && (
    <>
      <h2 style="margin-top: 3rem;">Retired takes</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Things I no longer believe. Changing your mind in public is a feature.
      </p>
      {retired.map((take) => <TakeCard take={take} />)}
    </>
  )}
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#topic-filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('#takes-list .take-card');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');

      const topic = chip.dataset.topic;
      cards.forEach((card) => {
        const cardTopics = (card.dataset.topics ?? '').split(',');
        card.style.display =
          topic === 'all' || cardTopics.includes(topic ?? '') ? '' : 'none';
      });
    });
  });
</script>
