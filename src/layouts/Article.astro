---
// A single piece of writing or a case study: header, stamps, then the prose.
import Base from './Base.astro';
import Stamp from '../components/Stamp.astro';
import TopicTags from '../components/TopicTags.astro';
import { isoDate, longDate } from '../lib/format';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;      // "essay", "note", "case study"
  date: Date;
  updated?: Date;
  status?: 'evergreen' | 'dated' | 'draft';
  topics?: string[];
  locale: string;
  backHref: string;
  backLabel: string;
}

const { title, description, eyebrow, date, updated, status, topics = [], locale, backHref, backLabel } = Astro.props;
---

<Base title={title} description={description}>
  <article class="article">
    <header class="head">
      <p class="label crumbs"><a href={backHref}>{backLabel}</a>{eyebrow && <span> / {eyebrow}</span>}</p>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      <p class="meta">
        <time class="label" datetime={isoDate(date)}>{longDate(date, locale)}</time>
        {updated && <Stamp date={updated} prefix="updated" locale={locale} />}
        <TopicTags topics={topics} />
      </p>
      {status === 'dated' && (
        <p class="notice">This piece is dated: it reflects what I thought at the time, kept for the record.</p>
      )}
      {status === 'draft' && <p class="notice">Draft — not listed anywhere yet.</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .head {
    margin: var(--space-4) 0 var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }
  .crumbs {
    margin: 0 0 var(--space-3);
  }
  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: var(--measure);
    margin: 0 0 var(--space-3);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: 0;
  }
  .notice {
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    background: var(--accent-soft);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }
</style>
