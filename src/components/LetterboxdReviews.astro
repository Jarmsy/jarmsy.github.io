---
// Letterboxd activity, read at build time from the public diary feed
// (src/lib/letterboxd.ts) and baked into the page: the scheduled rebuild
// keeps it fresh, and nothing runs on a server. If the feed can't be read
// or no username is set, this section isn't rendered — the rest of the
// page is unaffected.
//
// "Last watched" is fixed; "Top reviews lately" ships with one weighted-
// random pick already rendered (works without JavaScript) and the full pool
// embedded as JSON so Shuffle can re-pick in the browser.
import { getLetterboxd, type Entry } from '../lib/letterboxd';
import { weightedSample } from '../lib/sample';

interface Props {
  username: string;
  topCount: number;
}

const { username, topCount } = Astro.props;
const data = await getLetterboxd(username);
const initial = data ? weightedSample(data.pool, topCount, (e) => e.rating ?? 1) : [];

function stars(rating: number | null) {
  if (rating === null) return '';
  return '★'.repeat(Math.floor(rating)) + (rating % 1 >= 0.5 ? '½' : '');
}
---

{data && (
  <section class="letterboxd" id="last-watched" data-letterboxd data-top-count={topCount}>
    <div class="recent">
      <h2>Last watched</h2>
      <div class="card">
        {data.mostRecent.poster && <img src={data.mostRecent.poster} alt="" loading="lazy" />}
        <div class="info">
          <a class="title" href={data.mostRecent.link} target="_blank" rel="noopener">
            {data.mostRecent.title}{data.mostRecent.year ? ` (${data.mostRecent.year})` : ''}
          </a>
          {data.mostRecent.rating !== null && (
            <span class="rating" aria-label={`${data.mostRecent.rating} of 5 stars`}>{stars(data.mostRecent.rating)}</span>
          )}
          {data.mostRecent.review && <p class="review">{data.mostRecent.review}</p>}
        </div>
      </div>
    </div>
    {data.pool.length > 0 && (
      <div class="top">
        <div class="top-head">
          <h2>Top reviews lately</h2>
          <button type="button" class="shuffle" data-shuffle>Shuffle</button>
        </div>
        <ol class="list" data-top>
          {initial.map((e: Entry) => (
            <li>
              {e.poster && <img src={e.poster} alt="" loading="lazy" />}
              <div class="info">
                <a class="title" href={e.link} target="_blank" rel="noopener">{e.title}{e.year ? ` (${e.year})` : ''}</a>
                {e.rating !== null && <span class="rating" aria-label={`${e.rating} of 5 stars`}>{stars(e.rating)}</span>}
                {e.review && <p class="review">{e.review}</p>}
              </div>
            </li>
          ))}
        </ol>
        <script is:inline type="application/json" data-pool set:html={JSON.stringify(data.pool)} />
      </div>
    )}
    <p class="label note">From my <a href={`https://letterboxd.com/${username}/`} target="_blank" rel="noopener noreferrer">Letterboxd</a>.</p>
  </section>
)}

<script>
  import { weightedSample } from '../lib/sample';

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  function stars(rating: number | null) {
    if (rating === null) return '';
    return '★'.repeat(Math.floor(rating)) + (rating % 1 >= 0.5 ? '½' : '');
  }

  function card(entry: any): string {
    return `
      ${entry.poster ? `<img src="${esc(entry.poster)}" alt="" loading="lazy" />` : ''}
      <div class="info">
        <a class="title" href="${esc(entry.link)}" target="_blank" rel="noopener">${esc(entry.title)}${entry.year ? ` (${entry.year})` : ''}</a>
        ${entry.rating !== null ? `<span class="rating" aria-label="${entry.rating} of 5 stars">${stars(entry.rating)}</span>` : ''}
        ${entry.review ? `<p class="review">${esc(entry.review)}</p>` : ''}
      </div>
    `;
  }

  function init() {
    const section = document.querySelector<HTMLElement>('[data-letterboxd]');
    const topEl = section?.querySelector<HTMLElement>('[data-top]');
    const json = section?.querySelector<HTMLElement>('[data-pool]')?.textContent;
    if (!section || !topEl || !json) return;

    const pool: any[] = JSON.parse(json);
    const topCount = Number(section.dataset.topCount) || 3;
    section.querySelector('[data-shuffle]')?.addEventListener('click', () => {
      const picked = weightedSample(pool, topCount, (e) => e.rating ?? 1);
      topEl.innerHTML = picked.map((e) => `<li>${card(e)}</li>`).join('');
    });
  }

  // Runs on first load and again after every client-side navigation.
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .letterboxd {
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: grid;
    gap: var(--space-4);
  }
  .letterboxd h2 {
    font-size: var(--step-0);
    margin: 0;
  }
  .top-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .shuffle {
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 999px;
    padding: 0.2em 0.8em;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .shuffle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .card,
  .list :global(li) {
    display: flex;
    gap: var(--space-3);
  }
  .card :global(img),
  .list :global(img) {
    width: 3.5rem;
    height: auto;
    border-radius: 4px;
    flex: none;
  }
  .card :global(.info),
  .list :global(.info) {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    min-width: 0;
  }
  .card :global(.title),
  .list :global(.title) {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .card :global(.title:hover),
  .list :global(.title:hover) {
    color: var(--accent);
  }
  .card :global(.rating),
  .list :global(.rating) {
    color: var(--accent);
    letter-spacing: 0.1em;
    font-size: var(--step--1);
  }
  .card :global(.review),
  .list :global(.review) {
    margin: 0.2em 0 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    text-wrap: pretty;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .list :global(li + li) {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .note {
    margin: 0;
  }
</style>
