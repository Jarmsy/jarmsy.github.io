---
// Live Letterboxd activity, fetched client-side from a Netlify function
// (netlify/functions/letterboxd-reviews.js) so it updates without a
// rebuild. If the function errors or no username is set, this just
// doesn't render — the rest of the page is unaffected.
interface Props {
  username: string;
  topCount: number;
}

const { username, topCount } = Astro.props;
---

{username && (
  <section class="letterboxd" id="last-watched" data-letterboxd data-username={username} data-top-count={topCount} hidden>
    <div class="recent">
      <h2>Last watched</h2>
      <div class="card" data-recent></div>
    </div>
    <div class="top">
      <div class="top-head">
        <h2>Top reviews lately</h2>
        <button type="button" class="shuffle" data-shuffle>Shuffle</button>
      </div>
      <ol class="list" data-top></ol>
    </div>
    <p class="label note">From my <a href={`https://letterboxd.com/${username}/`} target="_blank" rel="noopener noreferrer">Letterboxd</a>.</p>
  </section>
)}

<script>
  function stars(rating: number | null) {
    if (rating === null) return '';
    const full = Math.floor(rating);
    const half = rating % 1 >= 0.5;
    return '★'.repeat(full) + (half ? '½' : '');
  }

  function card(entry: any): string {
    return `
      ${entry.poster ? `<img src="${entry.poster}" alt="" loading="lazy" />` : ''}
      <div class="info">
        <a class="title" href="${entry.link}" target="_blank" rel="noopener">${entry.title}${entry.year ? ` (${entry.year})` : ''}</a>
        ${entry.rating !== null ? `<span class="rating" aria-label="${entry.rating} of 5 stars">${stars(entry.rating)}</span>` : ''}
        ${entry.review ? `<p class="review">${entry.review}</p>` : ''}
      </div>
    `;
  }

  // Weighted random sample, without replacement, favouring higher ratings —
  // not a fixed "top N," so every reviewed film has some chance of showing,
  // not just whichever ones are tied for the highest rating. This is the
  // "A-ES" algorithm: each item gets a random key raised by 1/weight, and
  // the highest keys win.
  function sample<T extends { rating: number | null }>(pool: T[], count: number): T[] {
    return pool
      .map((item) => ({ item, key: Math.random() ** (1 / Math.max(item.rating ?? 1, 0.1)) }))
      .sort((a, b) => b.key - a.key)
      .slice(0, count)
      .map(({ item }) => item);
  }

  const section = document.querySelector<HTMLElement>('[data-letterboxd]');
  if (section) {
    const recentEl = section.querySelector<HTMLElement>('[data-recent]');
    const topEl = section.querySelector<HTMLElement>('[data-top]');
    const shuffleBtn = section.querySelector<HTMLButtonElement>('[data-shuffle]');
    const username = section.dataset.username!;
    const topCount = Number(section.dataset.topCount) || 3;

    function renderTop(pool: any[]) {
      if (!topEl) return;
      const picked = sample(pool, topCount);
      topEl.innerHTML = picked.map((e) => `<li>${card(e)}</li>`).join('');
    }

    fetch(`/.netlify/functions/letterboxd-reviews?username=${encodeURIComponent(username)}`)
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then(({ mostRecent, pool }) => {
        if (!mostRecent) throw new Error('empty');
        if (recentEl) recentEl.innerHTML = card(mostRecent);

        if (Array.isArray(pool) && pool.length > 0) {
          renderTop(pool);
          shuffleBtn?.addEventListener('click', () => renderTop(pool));
        } else {
          section.querySelector('.top')?.remove();
        }
        section.hidden = false;
      })
      .catch(() => {
        section.hidden = true;
      });
  }
</script>

<style>
  .letterboxd {
    margin-bottom: var(--space-5);
    padding: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: grid;
    gap: var(--space-4);
  }
  .letterboxd[hidden] {
    display: none;
  }
  .letterboxd h2 {
    font-size: var(--step-0);
    margin: 0;
  }
  .top-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .shuffle {
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: 999px;
    padding: 0.2em 0.8em;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .shuffle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .card,
  .list li {
    display: flex;
    gap: var(--space-3);
  }
  .card :global(img),
  .list :global(img) {
    width: 3.5rem;
    height: auto;
    border-radius: 4px;
    flex: none;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    min-width: 0;
  }
  .title {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .title:hover {
    color: var(--accent);
  }
  .rating {
    color: var(--accent);
    letter-spacing: 0.1em;
    font-size: var(--step--1);
  }
  .review {
    margin: 0.2em 0 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    text-wrap: pretty;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .list li + li {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }
  .note {
    margin: 0;
  }
</style>
