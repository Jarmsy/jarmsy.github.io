---
// "The bug in my own numbers": 44 people who remembered switching, and the
// four estimates that shrank once their memories were checked.
import './dnc.css';
import { recall } from './data';

const { panel, corrections } = recall;
const other = panel.recalled_switchers - panel.true_switchers_among_them - panel.reported_trump_in_2020;
const units = [
  ...Array(panel.true_switchers_among_them).fill({ kind: 'real', title: 'Reported voting Biden in November 2020' }),
  ...Array(panel.reported_trump_in_2020).fill({ kind: 'trump', title: 'Had told the survey in 2020 they voted Trump' }),
  ...Array(other).fill({ kind: 'none', title: 'No 2020 vote report' }),
];
const rows = [
  { ...corrections.biden_switch_rate, fmt: (v: number) => `${v.toFixed(1)}%` },
  { ...corrections.switchers_per_reverse_switcher, fmt: (v: number) => `${v.toFixed(1)} to 1` },
  { ...corrections.switching_share_of_shift_pct, fmt: (v: number) => `${v.toFixed(1)}%` },
  { ...corrections.much_worse_switch_rate_pct, fmt: (v: number) => `${v.toFixed(1)}%` },
];
const caption =
  'Of 44 people who remembered switching from Biden to Trump, 9 had told the same survey in 2020 that they voted Trump. Correcting for this shrank my estimates but left the patterns intact.';
---

<figure class="recall" id="chart-sidebar_recall" aria-describedby="cap-recall">
  <div class="grid">
    <div>
      <p class="sub">{panel.recalled_switchers} people who remembered voting Biden in 2020, then voted Trump</p>
      <div class="units" role="img" aria-label={`${panel.true_switchers_among_them} had reported voting Biden in 2020, ${panel.reported_trump_in_2020} had reported voting Trump, ${other} gave no 2020 report`}>
        {units.map((u) => <span class={`unit ${u.kind}`} title={u.title}></span>)}
      </div>
      <ul class="key">
        <li><span class="unit real"></span>{panel.true_switchers_among_them} had reported Biden in 2020</li>
        <li><span class="unit trump"></span>{panel.reported_trump_in_2020} had voted Trump in 2020</li>
        <li><span class="unit none"></span>{other} no 2020 report</li>
      </ul>
    </div>
    <div>
      <p class="sub">What the correction changed (before → after)</p>
      <ul class="changes">
        {rows.map((r) => (
          <li>
            <span class="vals"><s>{r.fmt(r.before)}</s> → <strong>{r.fmt(r.after)}</strong></span>
            <span class="what">{r.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <figcaption id="cap-recall">{caption}</figcaption>
</figure>

<style>
  .recall {
    margin: var(--space-4) 0 var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .chart-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    margin: 0 0 var(--space-2);
  }
  .units {
    display: grid;
    grid-template-columns: repeat(11, 1.1rem);
    gap: 3px;
    margin-bottom: var(--space-2);
  }
  .unit {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 2px;
  }
  .unit.real { background: var(--g-switch); }
  .unit.trump { background: var(--g-rep); }
  .unit.none { background: var(--g-ref); }
  .key,
  .changes {
    list-style: none;
    padding: 0 !important;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .key li { display: flex; align-items: center; gap: 0.5em; margin: 0.2em 0 0 !important; }
  .key .unit { width: 0.8rem; height: 0.8rem; }
  .changes li { display: grid; gap: 0.1em; margin: 0 0 var(--space-2) !important; line-height: 1.4; }
  .vals { font-size: var(--step-0); color: var(--text); font-variant-numeric: tabular-nums; }
  .vals s { color: var(--text-muted); }
  .vals strong { font-weight: 600; }
  figcaption {
    text-align: left !important;
    margin-top: var(--space-2) !important;
    line-height: 1.5;
  }
</style>
