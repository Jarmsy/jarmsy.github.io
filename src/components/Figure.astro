---
// Reusable figure with a consistently styled caption.
// Use in .mdx files:
//   import Figure from '../../components/Figure.astro';
//   <Figure src="/images/chart.png" alt="A chart" caption="The chart in question." />
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
  <img src={src} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
