---
interface Props {
  title: string;
  href?: string;
  more?: string;
}

const { title, href, more = 'all' } = Astro.props;
---

<div class="section-head">
  <h2>{title}</h2>
  {href && <a class="more" href={href}>{more} →</a>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-5) 0 var(--space-3);
  }
  .section-head h2 {
    margin: 0;
  }
  .more {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    white-space: nowrap;
  }
  .more:hover {
    text-decoration: underline;
  }
</style>
