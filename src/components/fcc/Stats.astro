---
// The four headline figures on the TV-ownership page, each with its
// narrower "programming only" counterpart underneath. Figures are from the
// analysis repo's data/national-results-2026-10-01.md; check a changed number
// there before editing it here.
const stats = [
  {
    value: '53 of 210',
    label: 'markets more concentrated in operation than on the record',
    narrow: '12 counting only agreements where the operator programs the station',
  },
  {
    value: '56 → 77',
    label: 'markets where one company runs at least half the stations',
    narrow: '56 → 62 programming only',
  },
  {
    value: '7.5M → 13.3M',
    label: 'TV households in those markets',
    narrow: '7.5M → 9.9M programming only',
  },
  {
    value: '3',
    label: 'markets that are “highly concentrated” only once the agreements count',
    narrow: '1 programming only (Providence)',
  },
];
---

<dl class="stats">
  {stats.map((s) => (
    <div>
      <dt>{s.label}</dt>
      <dd class="value">{s.value}</dd>
      <dd class="narrow">{s.narrow}</dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .stats div {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  dt {
    order: 2;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--text);
  }
  .value {
    order: 1;
    margin: 0 0 var(--space-1);
    font-size: var(--step-2);
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .narrow {
    order: 3;
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--text-muted);
  }
</style>
