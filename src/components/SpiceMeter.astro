---
interface Props {
  level: number;
  labels: [string, string, string];
}

const { level, labels } = Astro.props;
const label = labels[level - 1] ?? labels[0];
---

<span class="spice" title={label}>
  <span aria-hidden="true">{'🌶️'.repeat(level)}</span>
  <span class="spice-label">{label}</span>
</span>

<style>
  .spice {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .spice-label {
    font-style: italic;
  }
</style>
