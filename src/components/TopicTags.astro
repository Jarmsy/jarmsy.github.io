---
interface Props {
  topics: string[];
}

const { topics } = Astro.props;
---

{topics.length > 0 && (
  <span class="topics">
    {topics.map((topic) => <a class="tag" href={`/topics/${topic}/`}>{topic}</a>)}
  </span>
)}

<style>
  .topics {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    padding: 0.05em 0.65em;
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  .tag:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
